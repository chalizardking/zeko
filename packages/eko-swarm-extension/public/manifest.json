{
  "manifest_version": 3,
  "name": "Eko Swarm Extension",
  "version": "0.0.1",
  "description": "Multi-agent swarm browser extension powered by Eko",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Eko Swarm"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
